{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "description": "One yardstick the worldview comparison scores every worldview on.",
      "properties": {
        "id": {
          "pattern": "^[a-z]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "question": {
          "description": "The question the score answers, in plain words.",
          "maxLength": 300,
          "minLength": 10,
          "title": "Question",
          "type": "string"
        },
        "rule": {
          "default": "",
          "description": "How the score is assigned, stated once and applied to every worldview.",
          "maxLength": 600,
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "question"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "HistoryFact": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 400,
          "minLength": 3,
          "title": "Basis",
          "type": "string"
        },
        "fact": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Fact",
          "type": "string"
        },
        "pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Pct",
          "type": "integer"
        }
      },
      "required": [
        "fact",
        "pct",
        "basis"
      ],
      "title": "HistoryFact",
      "type": "object"
    },
    "LegendRow": {
      "additionalProperties": false,
      "properties": {
        "meaning": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Meaning",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "verdict",
        "meaning"
      ],
      "title": "LegendRow",
      "type": "object"
    },
    "ScoreboardRow": {
      "additionalProperties": false,
      "properties": {
        "argument": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Argument",
          "type": "string"
        },
        "as_posted": {
          "description": "Strength of the argument as usually stated, 0-10.",
          "maximum": 10,
          "minimum": 0,
          "title": "As Posted",
          "type": "integer"
        },
        "best_version": {
          "description": "Strength of the best defensible version, 0-10.",
          "maximum": 10,
          "minimum": 0,
          "title": "Best Version",
          "type": "integer"
        },
        "summary": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Summary",
          "type": "string"
        },
        "weakest_point": {
          "maxLength": 400,
          "minLength": 3,
          "title": "Weakest Point",
          "type": "string"
        }
      },
      "required": [
        "argument",
        "as_posted",
        "best_version",
        "weakest_point",
        "summary"
      ],
      "title": "ScoreboardRow",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "TRUE",
        "MOSTLY TRUE",
        "MIXED",
        "OVERSTATED",
        "MOSTLY FALSE",
        "FALSE",
        "OPEN",
        "STRAWMAN",
        "NOTE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Home-page data that is not a question or a claim: the scoreboard, the rubric legend,\nthe historical-facts table behind 'the big question', and the worldview criteria.",
  "properties": {
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "maxItems": 8,
      "title": "Criteria",
      "type": "array"
    },
    "evidence_note": {
      "default": "",
      "description": "How to read the evidence lists. No verdict.",
      "maxLength": 800,
      "title": "Evidence Note",
      "type": "string"
    },
    "evidence_rule": {
      "default": "",
      "description": "How every evidence strength is assigned, stated once and applied to both columns.",
      "maxLength": 900,
      "title": "Evidence Rule",
      "type": "string"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryFact"
      },
      "maxItems": 12,
      "title": "History",
      "type": "array"
    },
    "legend": {
      "items": {
        "$ref": "#/$defs/LegendRow"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Legend",
      "type": "array"
    },
    "scoreboard": {
      "items": {
        "$ref": "#/$defs/ScoreboardRow"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Scoreboard",
      "type": "array"
    },
    "worldview_note": {
      "default": "",
      "description": "How to read the worldview comparison. No verdict.",
      "maxLength": 800,
      "title": "Worldview Note",
      "type": "string"
    }
  },
  "required": [
    "scoreboard",
    "legend"
  ],
  "title": "SiteData",
  "type": "object"
}
