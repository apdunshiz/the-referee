{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block content %}
<section id="proof" class="hero" aria-labelledby="proof-h">
  <h1 id="proof-h">Is there a God? Here is the evidence, both ways.</h1>
  {% set n_lines = evidence_for | length + evidence_against | length %}<p class="lede">{{ n_lines }} line{{ "s" if n_lines != 1 }} of evidence, each weighed 0 to 10 with one public rule.</p>
  {% if proof.pct is not none %}
  {% set tilt = [[(50 - proof.pct) * 2.2, -10] | max, 10] | min %}
  <svg class="scale" viewBox="0 0 760 310" role="img" aria-label="{{ proof.pct }} percent of the evidence weight points to God, {{ 100 - proof.pct }} percent points away">
    <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <path d="M380 40V290M300 300h160" stroke-width="6"/>
      <circle cx="380" cy="40" r="9" fill="currentColor"/>
      <g transform="rotate({{ tilt }} 380 40)">
        <path d="M110 40h540" stroke-width="5"/>
        <path d="M110 40L40 190M110 40l70 150M650 40l-70 150M650 40l70 150"/>
        <path class="pan-for" d="M30 190h160a80 46 0 0 1-160 0z"/>
        <path class="pan-against" d="M570 190h160a80 46 0 0 1-160 0z"/>
        <text class="pan-num" x="110" y="222">{{ proof.pct }}%</text>
        <text class="pan-num" x="650" y="222">{{ 100 - proof.pct }}%</text>
      </g>
    </g>
    <text class="pan-cap cap-for" x="110" y="296">FOR GOD · {{ proof.sum_for }} of {{ proof.max_for }}</text>
    <text class="pan-cap cap-against" x="650" y="296">AGAINST · {{ proof.sum_against }} of {{ proof.max_against }}</text>
  </svg>
  <p class="verdict-call">{% if proof.pct >= 58 %}The evidence leans toward God.{% elif proof.pct <= 42 %}The evidence leans against God.{% else %}The two sides weigh about the same.{% endif %}</p>
  <p class="hero-cap">Not a probability that God exists. A scorecard you can check.</p>
  <details class="how">
    <summary>How these numbers are made</summary>
    <p>Every line below gets a strength from 0 to 10 for the argument as its summary states it. The left pan's share is the "for" total divided by both totals ({{ proof.sum_for }} for, {{ proof.sum_against }} against); 50% means the two columns weigh the same. The referee's average confidence across the lines is {{ proof.confidence }}%.</p>
    {% if site.evidence_rule %}<p><b>How each strength is set.</b> {{ site.evidence_rule }}</p>{% endif %}
    <p class="small">A percentage of evidence weight is not a probability that God exists; one decisive line would outweigh several weak ones. Change any line's strength on GitHub and these numbers move with it.</p>
  </details>
  {% else %}
  <p class="empty">No evidence written yet.</p>
  {% endif %}
</section>

<section id="evidence" aria-labelledby="evidence-h">
  <h2 id="evidence-h" class="vh">The evidence</h2>
  <div class="evidence-grid">
    {% for side, items, heading, pan, got in [("for", evidence_for, "Evidence for God", "Left pan", proof.sum_for), ("against", evidence_against, "Evidence against God", "Right pan", proof.sum_against)] %}
    <div class="ev-col ev-{{ side }}">
      <p class="step">{{ pan }}</p>
      <h3>{{ heading }} <span class="col-sum">{{ got }}</span></h3>
      {% if items %}
      {% for e in items %}
      <details class="ev-item">
        <summary><span class="wt-slot"><b class="wt" style="--s:{{ e.strength }}" aria-label="strength {{ e.strength }} out of 10">{{ e.strength }}</b></span><span class="ev-title">{{ e.title }}<span class="ev-conf">{{ e.confidence }}% confident in this score</span></span></summary>
        <p class="ev-summary">{{ e.summary }}</p>
        <p class="small"><a href="{{ base }}evidence/{{ e.id }}/">Open this line: objection, reply, sources</a></p>
      </details>
      {% endfor %}
      {% else %}
      <p class="empty">None written yet.</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% if site.evidence_note %}<p class="note">{{ site.evidence_note }}</p>{% endif %}
</section>

<section id="worldviews" aria-labelledby="worldviews-h">
  <p class="step">If there is an answer, which one?</p>
  <h2 id="worldviews-h">Which religion makes the most sense?</h2>
  {% if worldviews %}
  <p class="small">Each worldview is scored 0 to 10 on the same {{ criteria | length }} criteria ({% for c in criteria %}{{ c.name | lower }}{{ ", " if not loop.last }}{% endfor %}), ranked by total. <a href="{{ base }}worldviews/">See every score and how the criteria work</a>.</p>
  <ol class="wv-cards" role="list">
    {% for w in worldviews %}
    <li><a href="{{ base }}worldviews/{{ w.id }}/"><span class="wv-total">{{ w.total }}<small>/{{ w.max_total }}</small></span><span class="wv-name">{{ w.name }}</span><span class="wv-line">{{ w.one_line }}</span></a></li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="empty">None written yet.</p>
  {% endif %}
  {% if site.worldview_note %}<p class="note">{{ site.worldview_note }}</p>{% endif %}
</section>

<div class="more">
  <section aria-labelledby="questions-h" id="questions">
    <h2 id="questions-h">Deep dives</h2>
    <p class="small">{{ questions | length }} questions ruled one at a time, every claim graded with sources. <a href="{{ base }}questions/">All questions and the scoreboard</a>.</p>
  </section>
  <section aria-labelledby="today-h">
    <h2 id="today-h">Today from r/DebateAChristian <span class="tag">auto-matched</span></h2>
    {% if today.no_runs %}
    <p class="small">No runs yet.</p>
    {% else %}
    <p class="small">{% if today.groups %}{{ today.count }} comments matched existing rulings today.{% else %}Nothing new matched today.{% endif %} <a href="{{ base }}today/">Full Today page</a></p>
    {% endif %}
  </section>
  <section aria-labelledby="rubric-h">
    <h2 id="rubric-h">How it's graded</h2>
    <p class="badges">{% for row in legend %}{{ m.badge(row.verdict) }} {% endfor %}</p>
    <p class="small">The rubric is public and fixed; the daily job never invents a verdict. <a href="{{ base }}rubric/">Read the rubric</a>.</p>
  </section>
</div>
{% endblock %}
